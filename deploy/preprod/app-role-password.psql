-- Pose le mot de passe du rôle bridé user_core_app (SECRETS.md n°7), APRÈS les
-- migrations : 001 crée le rôle sans mot de passe — une migration est versionnée, un
-- secret jamais. Le même geste sert la rotation (ROTATION.md).
--
-- Joué dans le conteneur Postgres, ce fichier sur l'entrée standard :
--   docker compose -p user-core-preprod -f deploy/preprod/compose.yaml exec -T postgres \
--     sh -c 'psql -X -q -U "$POSTGRES_USER" -d "$POSTGRES_DB"' < deploy/preprod/app-role-password.psql
--
-- La valeur vient de l'ENVIRONNEMENT du conteneur (admin.env) : elle n'apparaît dans
-- aucune ligne de commande, aucune sortie, aucun journal — même en cas de refus.
\set ON_ERROR_STOP on
\getenv app_password USER_CORE_APP_PASSWORD
\if :{?app_password}
\else
  DO $$ BEGIN RAISE EXCEPTION 'USER_CORE_APP_PASSWORD absent de l''environnement du conteneur (admin.env) : rien n''est posé'; END $$;
\endif
-- Un refus du serveur recopie d'ordinaire l'instruction fautive dans son journal : pas
-- ici, l'instruction porterait la valeur.
SET log_min_error_statement = panic;
SELECT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'user_core_app') AS role_present,
       length(:'app_password') >= 32 AS assez_long
\gset
\if :role_present
\else
  DO $$ BEGIN RAISE EXCEPTION 'le rôle user_core_app n''existe pas : jouer les migrations d''abord'; END $$;
\endif
\if :assez_long
\else
  DO $$ BEGIN RAISE EXCEPTION 'USER_CORE_APP_PASSWORD trop court (32 caractères au moins) : rien n''est posé'; END $$;
\endif
ALTER ROLE user_core_app WITH PASSWORD :'app_password';
\echo 'mot de passe du rôle bridé posé — valeur non affichée'
